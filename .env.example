# Пароль для входа в админ-панель (/admin). Обязателен в production.
ADMIN_PASSWORD=change-me

# Случайная длинная строка для подписи сессии: openssl rand -hex 32
SESSION_SECRET=

# Папка для базы данных SQLite и загруженных фото (по умолчанию ./data)
# DATA_DIR=/var/lib/hana-beauty

# Если сайт временно открыт по http без HTTPS — поставьте false, иначе вход в админку не сохранится
# COOKIE_SECURE=false

# Контакты магазина
STORE_PHONE=+82 10-7557-5906
STORE_WHATSAPP=821075575906
STORE_INSTAGRAM=hana_beauty.kazakhstan
# STORE_EMAIL=

# Не создавать демо-товары при первом запуске
# SEED=false
